[configuration]
entry_symbol="gdext_rust_init"
compatibility_minimum="4.5"
reloadable=false
[libraries]
macos.debug="res://native/bin/libcurl_godot.dylib"
macos.release="res://native/bin/libcurl_godot.dylib"
linux.debug.x86_64="res://native/bin/libcurl_godot.so"
linux.release.x86_64="res://native/bin/libcurl_godot.so"
windows.debug.x86_64="res://native/bin/curl_godot.dll"
windows.release.x86_64="res://native/bin/curl_godot.dll"
android.debug.arm64="res://native/bin/libcurl_godot.android.so"
android.release.arm64="res://native/bin/libcurl_godot.android.so"
android.debug.x86_64="res://native/bin/libcurl_godot.android-x86_64.so"
android.release.x86_64="res://native/bin/libcurl_godot.android-x86_64.so"
