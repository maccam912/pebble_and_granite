[configuration]
entry_symbol="gdext_rust_init"
compatibility_minimum="4.5"
reloadable=false
[libraries]
macos.debug="res://native/bin/libpebble_iroh.dylib"
macos.release="res://native/bin/libpebble_iroh.dylib"
linux.debug.x86_64="res://native/bin/libpebble_iroh.so"
linux.release.x86_64="res://native/bin/libpebble_iroh.so"
windows.debug.x86_64="res://native/bin/pebble_iroh.dll"
windows.release.x86_64="res://native/bin/pebble_iroh.dll"
android.debug.arm64="res://native/bin/libpebble_iroh.android.so"
android.release.arm64="res://native/bin/libpebble_iroh.android.so"
